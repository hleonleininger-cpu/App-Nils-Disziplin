# Kopiere diese Datei nach .env und trage die Werte aus dem Supabase-Dashboard ein
# (Project Settings > API Keys). Der Publishable Key ist öffentlich gedacht,
# die Daten schützt Row Level Security. Den Secret Key trägst du hier NIE ein.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Öffentlicher VAPID-Schlüssel für Web-Push (der private bleibt in den Supabase-Secrets)
VITE_VAPID_PUBLIC_KEY=
