# Kopiere diese Datei nach .env.local und trage die Werte aus dem Supabase-Dashboard ein
# (Project Settings > API). Der anon-Key ist öffentlich gedacht, die Daten schützt Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: öffentlicher VAPID-Schlüssel für Web-Push (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
